# API Configuration
APP_NAME=
DEBUG=

LLM_PROVIDER=""

API_KEY=""
GEMINI_MODEL=""

OPENAI_API_KEY=""
OPENAI_MODEL=""

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Database Configuration
DATABASE_URL=
#DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/ds_playground

# Database Secrets
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated list, e.g. http://localhost:3000,http://localhost:8501)
CORS_ORIGINS=

# Optional: where uploaded files are stored. Defaults to the repo-root "data"
# folder for local runs; Docker overrides this to /app/data automatically.
#DATA_DIR=
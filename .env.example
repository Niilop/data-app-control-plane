# Local API configuration. AI provider credentials are not used.
APP_NAME="Data Application Control Plane"
DEBUG=false
API_URL=http://localhost:8000

# Dedicated local development database (do not use another application's database).
# - Running the API directly on the host (`uv run uvicorn ...`) against devstack:
#     postgresql://app_user:replace-me@localhost:5432/data_app_control_plane
# - Running the backend in Docker Compose against devstack on the host:
#     postgresql://app_user:replace-me@host.docker.internal:5432/data_app_control_plane
# - Running the backend in Docker Compose against the bundled `local-db`
#   Compose profile (docker compose --profile local-db up):
#     postgresql://app_user:replace-me@db:5432/data_app_control_plane
DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/data_app_control_plane

# Isolated integration-test database (separate from DATABASE_URL above). Only
# used by `tests/integration`; unset to skip those tests. Must be its own
# disposable pgvector-capable PostgreSQL database, never a shared/dev one.
# TEST_DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/data_app_control_plane_test

# Credentials/name for the optional bundled `local-db` Compose profile only.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=data_app_control_plane
# Host port for the bundled `local-db` profile; defaults to 5433 to avoid
# colliding with devstack's PostgreSQL on 5432.
# POSTGRES_HOST_PORT=5433

# Development authentication: replace this with a locally generated random value.
SECRET_KEY=replace-with-a-random-local-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Optional legacy CSV upload storage (the route is not mounted by the platform API).
# DATA_DIR=/absolute/path/to/data
